# 复制本文件为 .env（HAI 镜像用户已自动备好）
# 详细配置说明：docs/ENV_ADVANCED.md

# 必填：OpenAI 兼容 LLM 配置（/v1/chat/completions）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 可选：LLM 调优参数（留空走代码默认值）
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=300

# HAI 镜像专用（无需修改）
MIRROR_MODE=tencent-intranet
HF_ENDPOINT=https://hf-mirror.com
USE_MODELSCOPE=true
