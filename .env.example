# 复制本文件为 .env 后，按实际情况填写。
# 本文件是唯一的「用户配置入口」，安装脚本和运行时都会优先从这里读取变量。
# 优先级: CLI 参数 > 进程环境变量 > .env > 脚本内置默认值.

# ==========================================================================
# 一、安装阶段配置
# ==========================================================================

# 下载镜像源模式（重要）
# 可选值:
#   auto              默认: 自动探测当前环境下最快的一组镜像
#   tencent-intranet  ✨ 腾讯云 ECS 服务器推荐（内网镜像，不走公网流量）
#   tencent           腾讯云公网镜像
#   china             阿里云 + 清华镜像（国内通用）
#   official          PyPI / NPM / HF / NodeSource 官方源（海外服务器推荐）
MIRROR_MODE=tencent-intranet

# 以下为「强制覆盖镜像」，留空则按上面的 MIRROR_MODE 自动选择。
# 一般不用改。
# PyPI 源 (uv / pip)
# UV_DEFAULT_INDEX=http://mirrors.tencentyun.com/pypi/simple
# NPM registry 源（前端依赖）
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
# Node.js setup 脚本地址（安装 Node.js 20.x 时的第一步下载）
# NODE_SETUP_URL=https://mirrors.tuna.tsinghua.edu.cn/nodesource/setup_20.x
# HuggingFace 镜像（模型下载）；腾讯云服务器默认使用 hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com

# 安装阶段超时（秒）；内网可不改；海外网络不稳可以调大
# UV_HTTP_TIMEOUT=120

# ==========================================================================
# 二、LLM / 翻译运行时配置（必需，三选一即可）
# ==========================================================================
#
# 优先级（代码里的生效顺序）：
#   LLM_BASE_URL + LLM_API_KEY (组 A) >
#   仅 LLM_API_KEY (组 B，默认官方 OpenAI) >
#   DASHSCOPE_API_KEY (组 C，向后兼容，走 DashScope OpenAI 兼容模式)
#
# 翻译 SDK 统一使用 openai 库的 chat.completions 接口，
# 任何兼容 OpenAI /v1/chat/completions 的服务都可以直接用：
#   - LMDeploy / vLLM / SGLang（本地部署）
#   - Ollama（LLM_BASE_URL=http://127.0.0.1:11434/v1 LLM_API_KEY=EMPTY）
#   - SiliconFlow / Groq / Together / DeepSeek / 智谱 / 月之暗面 / 火山方舟
#   - 官方 OpenAI
#   - 阿里云 DashScope（兼容模式，保留为兜底）

# --------------------------------------------------------------------------
# 【方案 A】通用 OpenAI 兼容（推荐，自由度最高）
# --------------------------------------------------------------------------
# 例 SiliconFlow：LLM_BASE_URL=https://api.siliconflow.cn/v1
# 例 本地 Ollama：LLM_BASE_URL=http://127.0.0.1:11434/v1
# 例 本地 vLLM/LMDeploy：LLM_BASE_URL=http://127.0.0.1:23333/v1
# 留空则不启用本方案，自动回落到 方案B 或 方案C。
LLM_BASE_URL=
# 对应上面 base_url 的 API Key；本地无鉴权部署填 'EMPTY' 或 'none' 占位。
LLM_API_KEY=
# 模型名，按 base_url 对应的仓库名填；不填按供应商给安全默认值。
# 例 Qwen2.5-72B：LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 例 GPT-4o-mini：LLM_MODEL=gpt-4o-mini
# 例 本地 Qwen：LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL=
# 采样温度，0.0=最保守，1.0=最发散；翻译推荐 0.05~0.2，留空默认 0.1
LLM_TEMPERATURE=
# 单次请求超时（秒），大批量翻译容易超过默认 60s，留空默认 300s
LLM_TIMEOUT=

# --------------------------------------------------------------------------
# 【方案 B】官方 OpenAI（只填 key，不填 base_url，自动走 https://api.openai.com/v1）
# --------------------------------------------------------------------------
# 如果你只打算用官方 OpenAI，这里填 sk-proj-xxx 即可，上面 A 组全部留空。
# （和上面 LLM_API_KEY 其实是同一个变量，为了文档清晰重复列一份）
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# 【方案 C】阿里云 DashScope 通义千问（向后兼容兜底，旧用户无需改配置）
# --------------------------------------------------------------------------
# 只要上面 A/B 两组都留空，且这里填了，就自动启用：
#   base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
#   model  默认 = qwen-flash（也可以用上面 LLM_MODEL=qwen-turbo 覆盖）
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
